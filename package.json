{
  "name": "izim",
  "version": "1.0.0",
  "private": true,
  "description": "İzim — yürüdüğün yolları kaydeden keşif haritası",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:android": "node scripts/build-web.mjs && npx cap sync android",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "playwright": "1.63.0"
  }
}
